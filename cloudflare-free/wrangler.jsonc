{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rendiv-studio",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",

  // Pertahankan URL *.workers.dev sebagai cadangan; tanpa baris ini
  // wrangler otomatis MENONAKTIFKANNYA saat routes custom domain dipakai.
  "workers_dev": true,

  // Static Assets: gratis & tak terbatas di Workers Free.
  // Worker hanya menangani /api/*, sisanya dilayani langsung dari edge.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // KV free tier: 100rb baca + 1rb tulis per hari. Cukup banyak untuk antrian job.
  // ID diisi otomatis oleh wrangler saat deploy pertama (automatic provisioning).
  "kv_namespaces": [
    { "binding": "JOBS" }
  ],

  "vars": {
    // diisi saat setup: "owner/repo" tempat workflow render berada
    "GITHUB_REPO": "xykalnotkel/rendiv-studio",
    // GitHub Actions melapor ke URL ini. Sengaja workers.dev: domain custom
    // berada di balik WAF zona yang memblokir IP runner (HTTP 403).
    "CALLBACK_ORIGIN": "https://rendiv-studio.akuntiktok76y.workers.dev"
  },

  // Domain custom. Cloudflare otomatis membuat record DNS + sertifikat SSL.
  // Subdomain workers.dev tetap aktif sebagai cadangan.
  "routes": [
    { "pattern": "video.xystudio.my.id", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
